# Application Environment (production, development, demo)
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Local Demo Mode (binds localhost only; startup refuses demo mode in production)
DEMO_MODE=true

# Database Configuration (SQLite persistent storage)
DATABASE_URL="sqlite:///./data/sentinel.db"

# LLM Configuration (Keys only server-side, never exposed to clients)
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# OIDC / Keycloak SSO Configuration
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/sentinel
OIDC_CLIENT_ID=sentinel-client
OIDC_AUDIENCE=sentinel-client
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/sentinel/protocol/openid-connect/certs

# CORS & Frontend Origins
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
